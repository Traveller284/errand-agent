# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: id of the webhook you register for your public URL
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# AI agent (optional). Leave GROQ_API_KEY empty to use the scripted agent.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# AGENT_MODE=scripted forces the scripted agent even when a key is set
AGENT_MODE=

# Catalog (optional)
CATALOG_PROVIDER=mock
CHANNEL3_API_KEY=

DATABASE_PATH=./data/errand.db